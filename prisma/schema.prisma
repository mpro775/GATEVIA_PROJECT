generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  active
  suspended
  invited
}
enum Direction {
  ltr
  rtl
}
enum ContentStatus {
  draft
  review
  published
  archived
}
enum MediaStatus {
  pending_upload
  processing
  ready
  failed
  archived
}
enum InsightType {
  article
  guide
  report
}
enum NavigationItemType {
  internal
  external
}
enum LeadStatus {
  new
  contacted
  qualified
  proposal
  won
  lost
}
enum LeadSource {
  contact
  consultation
  assessment
  landing_page
  manual
}
enum NotificationStatus {
  pending
  queued
  sent
  failed
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String               @unique @db.Citext
  passwordHash        String               @map("password_hash")
  displayName         String               @map("display_name")
  status              UserStatus           @default(invited)
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles               UserRole[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  uploads             Media[]
  leadAssignments     Lead[]
  leadNotes           LeadNote[]
  leadActivities      LeadActivity[]
  auditLogs           AuditLog[]
  createdPages        Page[]               @relation("PageCreator")
  updatedPages        Page[]               @relation("PageUpdater")
  insights            Insight[]

  @@map("users")
  createdServices Service[] @relation("ServiceCreator")
  updatedServices Service[] @relation("ServiceUpdater")
  updatedSettings GlobalSetting[]
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  name        String
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  refreshTokenHash String @map("refresh_token_hash")
  csrfTokenHash String @map("csrf_token_hash")
  userAgent String? @map("user_agent")
  ipHash String? @map("ip_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Language {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.VarChar(16)
  name String
  nativeName String @map("native_name")
  direction Direction
  isActive Boolean @default(true) @map("is_active")
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int @default(0) @map("sort_order")
  localeFormat String? @map("locale_format")
  dateLocale String? @map("date_locale")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  mediaTranslations MediaTranslation[]
  pageTranslations PageTranslation[]
  sectionTranslations PageSectionTranslation[]
  categoryTranslations ServiceCategoryTranslation[]
  serviceTranslations ServiceTranslation[]
  industryTranslations IndustryTranslation[]
  caseStudyTranslations CaseStudyTranslation[]
  insightCategoryTranslations InsightCategoryTranslation[]
  insightTranslations InsightTranslation[]
  tagTranslations TagTranslation[]
  faqTranslations FaqTranslation[]
  teamTranslations TeamMemberTranslation[]
  clientTranslations ClientTranslation[]
  partnerTranslations PartnerTranslation[]
  brandTranslations BrandTranslation[]
  productTranslations ProductVentureTranslation[]
  testimonialTranslations TestimonialTranslation[]
  certificationTranslations CertificationTranslation[]
  trustMetricTranslations TrustMetricTranslation[]
  navigationTranslations NavigationItemTranslation[]
  @@index([isActive, sortOrder])
  @@map("languages")
}

model MediaFolder {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent MediaFolder? @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MediaFolder[] @relation("MediaFolderTree")
  media Media[]
  @@unique([parentId, name])
  @@map("media_folders")
}

model Media {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folderId String? @map("folder_id") @db.Uuid
  storageProvider String @map("storage_provider")
  bucket String
  storageKey String @unique @map("storage_key")
  originalFilename String @map("original_filename")
  normalizedFilename String @map("normalized_filename")
  mimeType String @map("mime_type")
  extension String?
  sizeBytes BigInt @map("size_bytes")
  width Int?
  height Int?
  durationSeconds Decimal? @map("duration_seconds") @db.Decimal(12,3)
  checksum String?
  status MediaStatus @default(pending_upload)
  uploadedById String @map("uploaded_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  folder MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  translations MediaTranslation[]
  variants MediaVariant[]
  caseStudyMedia CaseStudyMedia[]
  @@index([status, createdAt])
  @@index([folderId, createdAt])
  @@map("media")
  productGallery ProductVentureMedia[]
  refsPageTranslation_ogMedia PageTranslation[] @relation("PageTranslation_ogMedia")
  refsServiceCategory_iconMedia ServiceCategory[] @relation("ServiceCategory_iconMedia")
  refsService_heroMedia Service[] @relation("Service_heroMedia")
  refsService_iconMedia Service[] @relation("Service_iconMedia")
  refsServiceTranslation_ogMedia ServiceTranslation[] @relation("ServiceTranslation_ogMedia")
  refsIndustry_heroMedia Industry[] @relation("Industry_heroMedia")
  refsIndustryTranslation_ogMedia IndustryTranslation[] @relation("IndustryTranslation_ogMedia")
  refsClient_logoMedia Client[] @relation("Client_logoMedia")
  refsCaseStudy_heroMedia CaseStudy[] @relation("CaseStudy_heroMedia")
  refsCaseStudyTranslation_ogMedia CaseStudyTranslation[] @relation("CaseStudyTranslation_ogMedia")
  refsInsight_coverMedia Insight[] @relation("Insight_coverMedia")
  refsInsight_downloadableMedia Insight[] @relation("Insight_downloadableMedia")
  refsInsightTranslation_ogMedia InsightTranslation[] @relation("InsightTranslation_ogMedia")
  refsTeamMember_photoMedia TeamMember[] @relation("TeamMember_photoMedia")
  refsPartner_logoMedia Partner[] @relation("Partner_logoMedia")
  refsBrand_logoMedia Brand[] @relation("Brand_logoMedia")
  refsBrand_coverMedia Brand[] @relation("Brand_coverMedia")
  refsBrandTranslation_ogMedia BrandTranslation[] @relation("BrandTranslation_ogMedia")
  refsProductVenture_logoMedia ProductVenture[] @relation("ProductVenture_logoMedia")
  refsProductVentureTranslation_ogMedia ProductVentureTranslation[] @relation("ProductVentureTranslation_ogMedia")
  refsTestimonial_logoMedia Testimonial[] @relation("Testimonial_logoMedia")
  refsCertification_logoMedia Certification[] @relation("Certification_logoMedia")
}

model MediaTranslation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId String @map("media_id") @db.Uuid
  locale String @db.VarChar(16)
  title String?
  altText String? @map("alt_text")
  caption String?
  decorative Boolean @default(false)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Restrict)
  @@unique([mediaId, locale])
  @@map("media_translations")
}

model MediaVariant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId String @map("media_id") @db.Uuid
  variantKey String @map("variant_key")
  storageKey String @unique @map("storage_key")
  mimeType String @map("mime_type")
  width Int
  height Int
  sizeBytes BigInt @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  @@unique([mediaId, variantKey, mimeType])
  @@map("media_variants")
}

model Page {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageType String @map("page_type")
  templateKey String @map("template_key")
  status ContentStatus @default(draft)
  featured Boolean @default(false)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdById String? @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy User? @relation("PageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PageUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  translations PageTranslation[]
  sections PageSection[]
  faqs PageFaq[]
  @@index([status, publishedAt])
  @@map("pages")
}

model PageTranslation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId String @map("page_id") @db.Uuid
  locale String @db.VarChar(16)
  title String
  slug String
  excerpt String?
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogTitle String? @map("og_title")
  ogDescription String? @map("og_description")
  ogMediaId String? @map("og_media_id") @db.Uuid
  canonicalUrl String? @map("canonical_url")
  robotsIndex Boolean @default(true) @map("robots_index")
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Restrict)
  @@unique([pageId, locale])
  @@unique([locale, slug])
  @@map("page_translations")
  ogMedia Media? @relation("PageTranslation_ogMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  @@index([ogMediaId])
}

model PageSection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId String @map("page_id") @db.Uuid
  sectionType String @map("section_type")
  sortOrder Int @map("sort_order")
  isVisible Boolean @default(true) @map("is_visible")
  settings Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  translations PageSectionTranslation[]
  @@unique([pageId, sortOrder])
  @@map("page_sections")
}

model PageSectionTranslation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId String @map("section_id") @db.Uuid
  locale String @db.VarChar(16)
  content Json
  section PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Restrict)
  @@unique([sectionId, locale])
  @@map("page_section_translations")
}

model ServiceCategory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iconMediaId String? @map("icon_media_id") @db.Uuid
  status ContentStatus @default(draft)
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations ServiceCategoryTranslation[]
  services Service[]
  @@index([status, sortOrder])
  @@map("service_categories")
  iconMedia Media? @relation("ServiceCategory_iconMedia", fields: [iconMediaId], references: [id], onDelete: Restrict)
  @@index([iconMediaId])
}

model ServiceCategoryTranslation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  locale String @db.VarChar(16)
  name String
  slug String
  description String?
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Restrict)
  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("service_category_translations")
}

model Service {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  heroMediaId String? @map("hero_media_id") @db.Uuid
  iconMediaId String? @map("icon_media_id") @db.Uuid
  status ContentStatus @default(draft)
  featured Boolean @default(false)
  sortOrder Int @default(0) @map("sort_order")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations ServiceTranslation[]
  industries ServiceIndustry[]
  caseStudies CaseStudyService[]
  insights InsightService[]
  faqs ServiceFaq[]
  leads Lead[]
  @@index([status, featured, sortOrder])
  @@map("services")
  createdById String? @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid
  createdBy User? @relation("ServiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ServiceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  heroMedia Media? @relation("Service_heroMedia", fields: [heroMediaId], references: [id], onDelete: Restrict)
  @@index([heroMediaId])
  iconMedia Media? @relation("Service_iconMedia", fields: [iconMediaId], references: [id], onDelete: Restrict)
  @@index([iconMediaId])
}

model ServiceTranslation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  locale String @db.VarChar(16)
  title String
  slug String
  shortDescription String @map("short_description")
  overview String
  whoFor Json @default("[]") @map("who_for")
  problems Json @default("[]")
  deliverables Json @default("[]")
  process Json @default("[]")
  benefits Json @default("[]")
  timelineText String? @map("timeline_text")
  ctaLabel String? @map("cta_label")
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogMediaId String? @map("og_media_id") @db.Uuid
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Restrict)
  @@unique([serviceId, locale])
  @@unique([locale, slug])
  @@map("service_translations")
  ogTitle String? @map("og_title")
  ogDescription String? @map("og_description")
  canonicalUrl String? @map("canonical_url")
  robotsIndex Boolean @default(true) @map("robots_index")
  ogMedia Media? @relation("ServiceTranslation_ogMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  @@index([ogMediaId])
}

model Industry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  heroMediaId String? @map("hero_media_id") @db.Uuid
  status ContentStatus @default(draft)
  featured Boolean @default(false)
  sortOrder Int @default(0) @map("sort_order")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations IndustryTranslation[]
  services ServiceIndustry[]
  caseStudies CaseStudyIndustry[]
  insights InsightIndustry[]
  clients Client[]
  brands Brand[]
  products ProductVenture[]
  leads Lead[]
  @@index([status, featured, sortOrder])
  @@map("industries")
  heroMedia Media? @relation("Industry_heroMedia", fields: [heroMediaId], references: [id], onDelete: Restrict)
  @@index([heroMediaId])
}

model IndustryTranslation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  industryId String @map("industry_id") @db.Uuid
  locale String @db.VarChar(16)
  name String
  slug String
  shortDescription String @map("short_description")
  overview String
  challenges Json @default("[]")
  opportunities Json @default("[]")
  ctaLabel String? @map("cta_label")
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogMediaId String? @map("og_media_id") @db.Uuid
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Restrict)
  @@unique([industryId, locale])
  @@unique([locale, slug])
  @@map("industry_translations")
  ogTitle String? @map("og_title")
  ogDescription String? @map("og_description")
  canonicalUrl String? @map("canonical_url")
  robotsIndex Boolean @default(true) @map("robots_index")
  ogMedia Media? @relation("IndustryTranslation_ogMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  @@index([ogMediaId])
}

model ServiceIndustry {
  serviceId String @map("service_id") @db.Uuid
  industryId String @map("industry_id") @db.Uuid
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)
  @@id([serviceId, industryId])
  @@map("service_industries")
}

model Client {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  logoMediaId String? @map("logo_media_id") @db.Uuid
  website String?
  industryId String? @map("industry_id") @db.Uuid
  countryCode String? @map("country_code")
  featured Boolean @default(false)
  publicVisibility Boolean @default(false) @map("public_visibility")
  sortOrder Int @default(0) @map("sort_order")
  status ContentStatus @default(draft)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  industry Industry? @relation(fields: [industryId], references: [id], onDelete: SetNull)
  translations ClientTranslation[]
  caseStudies CaseStudy[]
  testimonials Testimonial[]
  @@index([status, publicVisibility, sortOrder])
  @@map("clients")
  logoMedia Media? @relation("Client_logoMedia", fields: [logoMediaId], references: [id], onDelete: Restrict)
  @@index([logoMediaId])
}

model ClientTranslation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  locale String @db.VarChar(16)
  name String
  shortDescription String? @map("short_description")
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Restrict)
  @@unique([clientId, locale])
  @@map("client_translations")
}

model CaseStudy {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  anonymized Boolean @default(false)
  countryCode String? @map("country_code")
  heroMediaId String? @map("hero_media_id") @db.Uuid
  status ContentStatus @default(draft)
  featured Boolean @default(false)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  translations CaseStudyTranslation[]
  services CaseStudyService[]
  industries CaseStudyIndustry[]
  gallery CaseStudyMedia[]
  @@index([status, featured, publishedAt])
  @@map("case_studies")
  sortOrder Int @default(0) @map("sort_order")
  testimonials Testimonial[]
  heroMedia Media? @relation("CaseStudy_heroMedia", fields: [heroMediaId], references: [id], onDelete: Restrict)
  @@index([heroMediaId])
}

model CaseStudyTranslation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseStudyId String @map("case_study_id") @db.Uuid
  locale String @db.VarChar(16)
  title String
  slug String
  clientLabel String? @map("client_label")
  context String
  challenge String
  objectives Json @default("[]")
  solution String
  process Json @default("[]")
  results Json @default("[]")
  metrics Json @default("[]")
  testimonialText String? @map("testimonial_text")
  seoTitle String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogMediaId String? @map("og_media_id") @db.Uuid
  caseStudy CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Restrict)
  @@unique([caseStudyId, locale])
  @@unique([locale, slug])
  @@map("case_study_translations")
  ogTitle String? @map("og_title")
  ogDescription String? @map("og_description")
  canonicalUrl String? @map("canonical_url")
  robotsIndex Boolean @default(true) @map("robots_index")
  ogMedia Media? @relation("CaseStudyTranslation_ogMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  @@index([ogMediaId])
}

model CaseStudyService {
  caseStudyId String @map("case_study_id") @db.Uuid
  serviceId   String @map("service_id") @db.Uuid
  caseStudy CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  @@id([caseStudyId, serviceId])
  @@map("case_study_services")
}
model CaseStudyIndustry {
  caseStudyId String @map("case_study_id") @db.Uuid
  industryId  String @map("industry_id") @db.Uuid
  caseStudy CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)
  @@id([caseStudyId, industryId])
  @@map("case_study_industries")
}
model CaseStudyMedia {
  caseStudyId String @map("case_study_id") @db.Uuid
